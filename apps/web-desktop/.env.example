# Hermes Web — lokalna konfiguracja (kopiuj do .env; .env jest git-ignored).
# Czyta go deploy.sh (URL) i vite.config.ts (domeny).

# URL, pod który łączysz się z UI z przeglądarki / telefonu.
HERMES_WEB_URL=http://10.0.0.103:4174

# Dodatkowe nazwy hostów, które Vite ma przepuszczać (comma-separated).
WEB_ALLOWED_HOSTS=prod-server,hermes-web.emu-nessie.ts.net,.ts.net
