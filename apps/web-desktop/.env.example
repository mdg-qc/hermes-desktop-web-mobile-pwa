# Hermes Web — example local config (git-ignored).
# Copy this file to apps/web-desktop/.env
#   cp apps/web-desktop/.env.example apps/web-desktop/.env

# URL you open the UI from (browser / phone).
HERMES_WEB_URL=http://<your-host>:4174

# Extra hosts Vite should allow (comma-separated).
WEB_ALLOWED_HOSTS=

# --- Docker (hermes-web image): the container reads these from .env ---
# Hermes gateway — nginx proxies /api and /api/ws. In Docker host.docker.internal
# points to the host (requires --add-host host.docker.internal:host-gateway);
# outside Docker it is usually http://127.0.0.1:9119.
HERMES_GATEWAY_URL=http://host.docker.internal:9119

# Path inside the container to the hermes config (mount ~/.hermes there); nginx
# serves plugins/ and desktop-plugins/ from it.
HERMES_HOME=/data/hermes