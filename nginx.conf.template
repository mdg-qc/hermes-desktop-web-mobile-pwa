# nginx.conf template for Hermes Web (frontend-only Docker image).
# ${HERMES_GATEWAY_URL} and ${HERMES_HOME} are substituted by
# docker-entrypoint.sh (envsubst) at container start; every other $var is nginx's own.

events {}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Upgrade/Connection map needed for the /api/ws WebSocket proxy.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    server {
        listen 80;
        server_name _;

        root /usr/share/nginx/html;
        index index.html;

        # Cache static build assets aggressively (content-hashed filenames).
        location /assets/ {
            expires 30d;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # Hermes gateway — REST + WebSocket, same-origin (auth cookies/ws-tickets).
        location ~ ^/(api|auth|login) {
            proxy_pass ${HERMES_GATEWAY_URL};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600s;
        }

        # Desktop / agent plugin assets, served from the mounted hermes config
        # dir: /plugins -> $HERMES_HOME/plugins, /desktop-plugins -> $HERMES_HOME/desktop-plugins
        location /desktop-plugins/ {
            alias ${HERMES_HOME}/desktop-plugins/;
        }
        location /plugins/ {
            alias ${HERMES_HOME}/plugins/;
        }

        # Live dir listing for the bridge's readDir() (fixed in v0.1.1 — this used
        # to hardcode `[]` for /plugins and 404 for /desktop-plugins regardless of
        # what was actually mounted). nginx autoindex requires a request URI ending
        # in '/', so an exact-match `/plugins/.listing` would 301 to a trailing
        # slash and then fall through to the alias blocks above (404). Instead we
        # redirect `.listing` to `.listing/` and serve the trailing-slash form with
        # nginx's built-in autoindex (JSON) against the real ${HERMES_HOME}
        # directory — the same live behavior and [{name,type}] shape as the dev
        # middleware in vite.config.ts.
        location = /plugins/.listing { return 302 /plugins/.listing/; }
        location = /plugins/.listing/ {
            alias ${HERMES_HOME}/plugins/;
            autoindex on;
            autoindex_format json;
        }
        location = /desktop-plugins/.listing { return 302 /desktop-plugins/.listing/; }
        location = /desktop-plugins/.listing/ {
            alias ${HERMES_HOME}/desktop-plugins/;
            autoindex on;
            autoindex_format json;
        }

        # SPA fallback: any unknown route serves the app shell (hash-routed SPA).
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}